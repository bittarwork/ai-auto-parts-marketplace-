{
  "name": "chinese-auto-parts-backend",
  "version": "1.0.0",
  "description": "Backend API for Chinese Auto Parts E-Commerce Platform with AI Features",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "seed": "node scripts/seed.js",
    "seed:clear": "node scripts/seed.js --clear",
    "test": "jest --watchAll",
    "test:ci": "jest",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.js\""
  },
  "keywords": [
    "auto-parts",
    "e-commerce",
    "ai",
    "nlp",
    "express",
    "mongodb"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "mongoose": "^7.5.0",
    "dotenv": "^16.3.1",
    "cors": "^2.8.5",
    "helmet": "^7.0.0",
    "morgan": "^1.10.0",
    "compression": "^1.7.4",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "express-validator": "^7.0.1",
    "express-rate-limit": "^6.10.0",
    "ioredis": "^5.3.2",
    "openai": "^4.20.0",
    "axios": "^1.5.0",
    "multer": "^1.4.5-lts.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.1",
    "jest": "^29.7.0",
    "supertest": "^6.3.3",
    "eslint": "^8.50.0",
    "prettier": "^3.0.3"
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  }
}
